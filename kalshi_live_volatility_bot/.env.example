# KALSHI LIVE VOLATILITY TRADER - environment template.
# Copy to /etc/kalshi-live-volatility/klvb.env (chmod 600, owned by the service user).
# NEVER commit a filled-in copy. Keys are referenced by FILE PATH, never pasted inline.

# ---- mode (PAPER is the default; nothing below is required for PAPER or SHADOW) ----
TRADING_MODE=PAPER
# KILL_SWITCH=true            # stop all new orders (or: klvb kill --reason "...")

# ---- optional: alerts (Slack/Discord-compatible incoming webhook URL) ----
# KLVB_ALERT_WEBHOOK_URL=

# ---- optional: dashboard token (required only if the dashboard binds a non-loopback host) ----
# KLVB_DASHBOARD_TOKEN=

# ---- optional: authenticated websocket market data (read-only use; set data.use_websocket=true) ----
# KALSHI_DATA_API_KEY_ID=
# KALSHI_DATA_PRIVATE_KEY_PATH=/etc/kalshi-live-volatility/keys/data.pem

# ---- optional: Kalshi DEMO execution validation (DEMO ACCOUNT DEDICATED TO THIS BOT ONLY) ----
# KALSHI_DEMO_API_KEY_ID=
# KALSHI_DEMO_PRIVATE_KEY_PATH=/etc/kalshi-live-volatility/keys/demo.pem

# ---- LIVE ONLY. Loaded only when TRADING_MODE=LIVE and every readiness check passes ----
# KALSHI_PROD_API_KEY_ID=
# KALSHI_PROD_PRIVATE_KEY_PATH=/etc/kalshi-live-volatility/keys/prod.pem
# LIVE_TRADING_AUTHORIZED_BY=<your name>
# LIVE_TRADING_ACKNOWLEDGEMENT=I AUTHORIZE LIVE TRADING WITH REAL MONEY

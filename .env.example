# Kalshi Live Volatility Trader - environment. Copy to .env (chmod 600).
# This file belongs to THIS bot only; it shares nothing with kalshi-bot.

# PAPER (default) | SHADOW | LIVE.  LIVE also needs every readiness item,
# a recorded human authorization (`lvt authorize-live`) and the key below.
TRADING_MODE=PAPER

# Emergency stop for new orders (or: .venv/bin/python -m lvt kill on "reason")
KILL_SWITCH=false

# Optional: JSON POST per alert (ntfy / Slack / Discord style webhook)
ALERT_WEBHOOK_URL=

# Production credentials - leave EMPTY until LIVE is authorized.
# They are only read in LIVE mode and never logged or shown on the dashboard.
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=

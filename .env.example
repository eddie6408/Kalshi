# =====================================================================
#  Kalshi API credentials.  Copy this file to ".env" and fill it in.
#  NEVER commit the real .env file anywhere.
# =====================================================================

# The Key ID shown on kalshi.com when you created the API key (a UUID).
KALSHI_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the RSA private key .pem file Kalshi gave you. An absolute path
# works; a relative one is resolved against this project folder, which keeps
# the same .env working if you copy the folder to a server.
KALSHI_PRIVATE_KEY_PATH=../.kalshi/kalshi_private_key.pem

# "demo" or "prod".  Leave it on demo until you have paper-traded for weeks.
KALSHI_ENV=demo

# Optional - only if you turn on the Claude estimator later.
# ANTHROPIC_API_KEY=sk-ant-...
